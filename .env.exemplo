# Copie para .env (fora do git) e troque todos os valores.
# Senhas entram em URL de conexão: use só [A-Za-z0-9] (ex.: openssl rand -hex 24).
POSTGRES_PASSWORD=troque-esta-senha-do-dono
APP_DB_PASSWORD=troque-esta-senha-da-app
# 32 bytes em base64 (openssl rand -base64 32). Valor abaixo é fictício (zeros):
# a API o recusa com COOKIE_SECURE=true.
COFRE_SEGREDO=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
# Este exemplo é para desenvolvimento local sem HTTPS. Produção: COOKIE_SECURE=true
# (padrão do compose) e COFRE_SEGREDO gerado.
COOKIE_SECURE=false
# Opcional (produção): URL de push de um monitor Push do Uptime Kuma (heartbeat do backup).
BACKUP_PING_URL=
